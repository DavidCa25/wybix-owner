{
  "expo": {
    "name": "Wybix POS Mobile",
    "slug": "wybix-pos-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "wybixpos",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2A3F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wybix.posmobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.wybix.posmobile",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2A3F"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Para escanear el código de enrolamiento y los comprobantes de transferencia.",
          "recordAudioAndroid": false
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "wybix": {
        "backend": "https://www.wybixpos.com.mx/backend",
        "channel": "pos-production",
        "perfil": "produccion"
      },
      "eas": {
        "projectId": "6bbce3fd-963f-468c-a973-245a1f9995e1"
      }
    },
    "owner": "davidcasillas",
    "updates": {
      "url": "https://u.expo.dev/6bbce3fd-963f-468c-a973-245a1f9995e1"
    }
  }
}
