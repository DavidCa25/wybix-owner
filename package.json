{
  "name": "wybix-mobile",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "owner": "npm --workspace @wybix/owner run start",
    "pos": "npm --workspace @wybix/pos-mobile run start",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test packages/*/test/*.test.ts supabase/functions/_shared/test/*.test.ts",
    "test:fase1": "node --no-warnings scripts/probar-fase1.mjs",
    "test:fase2": "node --no-warnings scripts/probar-fase2.mjs",
    "test:licenciamiento": "node --no-warnings scripts/probar-licenciamiento.mjs",
    "test:fase3": "node --no-warnings scripts/probar-fase3.mjs",
    "test:quick": "node scripts/qa.mjs quick",
    "test:affected": "node scripts/qa.mjs affected",
    "test:integration": "node scripts/qa.mjs integration",
    "test:full": "node scripts/qa.mjs full"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/node": "^26.1.0"
  }
}
